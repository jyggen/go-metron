root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[go.mod]
indent_style = tab

# Upstream spec; refetching reintroduces the trailing whitespace.
[internal/openapi.yaml]
trim_trailing_whitespace = false

# Generated by internal/cmd/download-fixtures; written without a final newline.
[fixtures/*.json]
insert_final_newline = false
